diff --git a/tail_test.go b/tail_test.go
new file mode 100644
index 0000000..b93bb6b
--- /dev/null
+++ b/tail_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestTail(t *testing.T) {
+	in := "a,b\n1,2\n3,4\n5,6\n7,8\n"
+	cases := []struct {
+		n    int
+		want [][]string
+	}{
+		{0, [][]string{{"a", "b"}}},
+		{2, [][]string{{"a", "b"}, {"5", "6"}, {"7", "8"}}},
+		{4, [][]string{{"a", "b"}, {"1", "2"}, {"3", "4"}, {"5", "6"}, {"7", "8"}}},
+		{10, [][]string{{"a", "b"}, {"1", "2"}, {"3", "4"}, {"5", "6"}, {"7", "8"}}},
+	}
+	for _, c := range cases {
+		got, err := collect(t, func(w io.Writer) error {
+			return Tail(strings.NewReader(in), w, c.n, ',', false)
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(got, c.want) {
+			t.Errorf("n=%d: got %v, want %v", c.n, got, c.want)
+		}
+	}
+}
+
+func TestTailHeaderOnlyAndEmpty(t *testing.T) {
+	var buf bytes.Buffer
+	if err := Tail(strings.NewReader("a,b\n"), &buf, 5, ',', false); err != nil {
+		t.Fatal(err)
+	}
+	if buf.String() != "a,b\n" {
+		t.Errorf("header only: got %q", buf.String())
+	}
+	buf.Reset()
+	if err := Tail(strings.NewReader(""), &buf, 5, ',', false); err != nil {
+		t.Fatal(err)
+	}
+	if buf.Len() != 0 {
+		t.Errorf("empty input: got %q", buf.String())
+	}
+}
+
+func TestTailNegativeN(t *testing.T) {
+	var buf bytes.Buffer
+	if err := Tail(strings.NewReader("a\n1\n"), &buf, -1, ',', false); err == nil {
+		t.Fatal("want error for negative n")
+	}
+}
+
+func TestTailRaggedAndDelim(t *testing.T) {
+	in := "a;b;c\n1;2\n3;4;5\n"
+	var buf bytes.Buffer
+	if err := Tail(strings.NewReader(in), &buf, 2, ';', false); err != nil {
+		t.Fatal(err)
+	}
+	if want := "a;b;c\n1;2\n3;4;5\n"; buf.String() != want {
+		t.Errorf("got %q, want %q", buf.String(), want)
+	}
+}
+
+func TestTailLazyQuotes(t *testing.T) {
+	in := "a,b\n1,x\"y\n"
+	var buf bytes.Buffer
+	if err := Tail(strings.NewReader(in), &buf, 1, ',', false); err == nil {
+		t.Fatal("strict mode should reject a bare quote")
+	}
+	buf.Reset()
+	if err := Tail(strings.NewReader(in), &buf, 1, ',', true); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(buf.String(), "a,b\n") {
+		t.Errorf("lazy: got %q", buf.String())
+	}
+}
