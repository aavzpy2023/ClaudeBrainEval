+// Tail writes the header plus the last n data rows of the CSV in r to w. It
+// streams the input and keeps only n rows in a ring buffer, so memory use
+// depends on n, not on the size of the input.
+func Tail(r io.Reader, w io.Writer, n int, delim rune, lazy bool) error {
+	if n < 0 {
+		return fmt.Errorf("n must be >= 0, got %d", n)
+	}
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cr.ReuseRecord = true
+	cw := csv.NewWriter(w)
+	cw.Comma = delim
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if err := cw.Write(header); err != nil {
+		return err
+	}
+	// ReuseRecord means each record's backing array is overwritten on the next
+	// Read, so rows held in the ring must be copied.
+	ring := make([][]string, n)
+	total := 0
+	for {
+		rec, err := cr.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			cw.Flush()
+			return err
+		}
+		if n > 0 {
+			ring[total%n] = append(ring[total%n][:0], rec...)
+		}
+		total++
+	}
+	start := 0
+	count := total
+	if total > n {
+		start = total - n
+		count = n
+	}
+	for i := 0; i < count; i++ {
+		if err := cw.Write(ring[(start+i)%n]); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
