+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestDetectDelim(t *testing.T) {
+	for _, tc := range []struct {
+		line string
+		want rune
+	}{
+		{"a,b,c\n", ','},
+		{"a;b;c\n", ';'},
+		{"a\tb\tc\n", '\t'},
+		{"a|b|c\n", '|'},
+		{"a,b;c;d\n", ';'},
+		{"a,b,c;d\n", ','},
+		{"name\n", ','},
+		{"\"a;b;c\",d\n", ','},
+		{"\"x,y,z\";a|b|c\n", '|'},
+		{"\"x,y,z\";a|b\n", ';'},
+		{"", ','},
+	} {
+		if got := detectDelim(tc.line); got != tc.want {
+			t.Errorf("detectDelim(%q) = %q; want %q", tc.line, got, tc.want)
+		}
+	}
+}
+
+func TestHeadAutoDelim(t *testing.T) {
+	var buf bytes.Buffer
+	d, r, err := resolveDelim(strings.NewReader("a;b\n1;2\n"), autoDelim)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Head(r, &buf, 5, d, false); err != nil {
+		t.Fatal(err)
+	}
+	if got := buf.String(); got != "a;b\n1;2\n" {
+		t.Errorf("got %q", got)
+	}
+}
