+// resolveDelim returns delim unchanged unless it is autoDelim, in which case it
+// detects the delimiter from the first line of r. The returned reader yields
+// every byte of r, including the line that was read for detection.
+func resolveDelim(r io.Reader, delim rune) (rune, io.Reader, error) {
+	if delim != autoDelim {
+		return delim, r, nil
+	}
+	br := bufio.NewReader(r)
+	line, err := br.ReadString('\n')
+	if err != nil && err != io.EOF {
+		return 0, nil, err
+	}
+	return detectDelim(line), io.MultiReader(strings.NewReader(line), br), nil
+}
+
+// detectDelim returns the most frequent of comma, semicolon, tab and pipe in
+// line, ignoring characters inside quotes. Ties go to the earlier candidate in
+// that order, and no candidate at all gives a comma.
+func detectDelim(line string) rune {
+	counts := map[rune]int{}
+	inQuotes := false
+	for _, r := range line {
+		switch {
+		case r == '"':
+			inQuotes = !inQuotes
+		case !inQuotes && (r == ',' || r == ';' || r == '\t' || r == '|'):
+			counts[r]++
+		}
+	}
+	best := ','
+	for _, c := range []rune{';', '\t', '|'} {
+		if counts[c] > counts[best] {
+			best = c
+		}
+	}
+	return best
+}
