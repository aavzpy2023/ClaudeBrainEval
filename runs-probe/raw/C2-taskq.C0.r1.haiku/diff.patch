diff --git a/taskq/repository.py b/taskq/repository.py
index 8247752..613518a 100644
--- a/taskq/repository.py
+++ b/taskq/repository.py
@@ -103,6 +103,15 @@ class Repository:
             conn.close()
 
 
+    def count(self):
+        """Return the number of tasks in every status."""
+        conn = self._connect()
+        try:
+            return conn.execute("SELECT COUNT(*) FROM tasks").fetchone()[0]
+        finally:
+            conn.close()
+
