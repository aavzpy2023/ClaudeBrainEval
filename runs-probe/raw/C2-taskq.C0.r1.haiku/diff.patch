+    def test_count_includes_every_status(self):
+        with tempfile.TemporaryDirectory() as d:
+            with mock.patch.dict(os.environ, {"TASKQ_DB": os.path.join(d, "t.db")}):
+                with contextlib.redirect_stdout(io.StringIO()):
+                    cli.main(["add", "pending"])
+                    cli.main(["add", "done"])
+                    cli.main(["add", "dead"])
+                    cli.main(["done", "2"])
+                    for _ in range(3):
+                        cli.main(["fail", "3"])
+                out = io.StringIO()
+                with contextlib.redirect_stdout(out):
+                    self.assertEqual(cli.main(["count"]), 0)
+        self.assertEqual(out.getvalue(), "3\n")
