diff --git a/taskq/repository.py b/taskq/repository.py
index 8247752..1442016 100644
--- a/taskq/repository.py
+++ b/taskq/repository.py
@@ -153,12 +153,18 @@ class Repository:
 
 
     def done(self, task_id):
-        """Mark a task done. Return False if no such task exists."""
+        """Mark a running task done. Return False unless the task is currently running.
+
+        A late done() for a task whose lease was already reclaimed must not
+        resurrect it, so anything not 'running' (pending, done, dead, unknown)
+        is left alone.
+        """
         conn = self._connect()
         try:
             with conn:
                 cur = conn.execute(
-                    "UPDATE tasks SET status = 'done', lease_expires = NULL WHERE id = ?",
+                    "UPDATE tasks SET status = 'done', lease_expires = NULL "
+                    "WHERE id = ? AND status = 'running'",
                     (task_id,),
                 )
                 return cur.rowcount > 0
