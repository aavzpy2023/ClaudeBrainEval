@@ -0,0 +1,59 @@
+package main
+
+import (
+	"bufio"
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Distinct streams the CSV in r and writes each distinct value of column col
+// to w, one per line, in order of first appearance. An empty cell is a value
+// like any other. Values are written as-is, without CSV quoting.
+func Distinct(r io.Reader, w io.Writer, col string, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cr.ReuseRecord = true
+	header, err := cr.Read()
+	if err == io.EOF {
+		return fmt.Errorf("%w: %q (empty input)", ErrMissingColumn, col)
+	}
+	if err != nil {
+		return err
+	}
+	idx := -1
+	for j, h := range header {
+		if h == col {
+			idx = j
+			break
+		}
+	}
+	if idx < 0 {
+		return fmt.Errorf("%w: %q", ErrMissingColumn, col)
+	}
+	bw := bufio.NewWriter(w)
+	seen := make(map[string]bool)
+	for {
+		rec, err := cr.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			bw.Flush()
+			return err
+		}
+		v := ""
+		if idx < len(rec) {
+			v = rec[idx]
+		}
+		if seen[v] {
+			continue
+		}
+		seen[v] = true
+		bw.WriteString(v)
+		bw.WriteByte('\n')
+	}
+	return bw.Flush()
+}
diff --git a/distinct_test.go b/distinct_test.go
new file mode 100644
index 0000000..d7ece5c
--- /dev/null
+++ b/distinct_test.go
@@ -0,0 +1,71 @@
+package main
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func distinctOf(in, col string) (string, error) {
+	var sb strings.Builder
+	err := Distinct(strings.NewReader(in), &sb, col, ',', false)
+	return sb.String(), err
+}
+
+func TestDistinctFirstAppearanceOrder(t *testing.T) {
+	got, err := distinctOf("a,b\nx,1\ny,2\nx,3\nz,4\ny,5\n", "a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "x\ny\nz\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDistinctEmptyCellIsAValue(t *testing.T) {
+	got, err := distinctOf("a,b\n,1\nx,2\n,3\n", "a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "\nx\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDistinctShortRow(t *testing.T) {
+	got, err := distinctOf("a,b\nx,1\nx\ny,2\n", "b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "1\n\n2\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDistinctNoRows(t *testing.T) {
+	got, err := distinctOf("a,b\n", "a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "" {
+		t.Fatalf("got %q, want empty", got)
+	}
+}
+
+func TestDistinctMissingColumn(t *testing.T) {
+	for _, in := range []string{"a,b\n1,2\n", ""} {
+		if _, err := distinctOf(in, "z"); !errors.Is(err, ErrMissingColumn) {
+			t.Fatalf("input %q: want ErrMissingColumn, got %v", in, err)
+		}
+	}
+}
+
+func TestDistinctDelim(t *testing.T) {
+	var sb strings.Builder
+	if err := Distinct(strings.NewReader("a;b\nx;1\nx;2\ny;3\n"), &sb, "a", ';', false); err != nil {
+		t.Fatal(err)
+	}
+	if want := "x\ny\n"; sb.String() != want {
+		t.Fatalf("got %q, want %q", sb.String(), want)
+	}
+}
