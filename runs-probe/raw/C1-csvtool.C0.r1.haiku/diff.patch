+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Count streams the CSV in r and writes the number of data rows, every record
+// after the header, to w as a single line. Empty input has no header and counts
+// as 0 rows.
+func Count(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cr.ReuseRecord = true
+	if _, err := cr.Read(); err == io.EOF {
+		_, err = fmt.Fprintln(w, 0)
+		return err
+	} else if err != nil {
+		return err
+	}
+	var count int
+	for {
+		_, err := cr.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return err
+		}
+		count++
+	}
+	_, err := fmt.Fprintln(w, count)
+	return err
+}
diff --git a/count_test.go b/count_test.go
new file mode 100644
index 0000000..16ac8b7
--- /dev/null
+++ b/count_test.go
@@ -0,0 +1,58 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func countOf(in string) (string, error) {
+	var sb strings.Builder
+	err := Count(strings.NewReader(in), &sb, ',', false)
+	return sb.String(), err
+}
+
+func TestCountDataRows(t *testing.T) {
+	got, err := countOf("a,b\n1,2\n3,4\n5,6\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "3\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestCountHeaderOnlyAndEmpty(t *testing.T) {
+	for _, in := range []string{"a,b\n", "a,b", ""} {
+		got, err := countOf(in)
+		if err != nil {
+			t.Fatalf("input %q: %v", in, err)
+		}
+		if want := "0\n"; got != want {
+			t.Fatalf("input %q: got %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestCountDelim(t *testing.T) {
+	var sb strings.Builder
+	if err := Count(strings.NewReader("a;b\n1;2\n3;4\n"), &sb, ';', false); err != nil {
+		t.Fatal(err)
+	}
+	if want := "2\n"; sb.String() != want {
+		t.Fatalf("got %q, want %q", sb.String(), want)
+	}
+}
+
+func TestCountLazyQuotes(t *testing.T) {
+	in := "a,b\n1,x\"y\n"
+	if _, err := countOf(in); err == nil {
+		t.Fatal("want error for bare quote without lazy quotes")
+	}
+	var sb strings.Builder
+	if err := Count(strings.NewReader(in), &sb, ',', true); err != nil {
+		t.Fatal(err)
+	}
+	if want := "1\n"; sb.String() != want {
+		t.Fatalf("got %q, want %q", sb.String(), want)
+	}
+}
