new file mode 100644
index 0000000..2e644b5
--- /dev/null
+++ b/tail.go
@@ -0,0 +1,58 @@
+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Tail writes the header plus the last n data rows of the CSV in r to w. The
+// whole input is read, but only the last n rows are held in memory at once, so
+// memory use does not depend on input size. Nothing is written if reading fails.
+func Tail(r io.Reader, w io.Writer, n int, delim rune, lazy bool) error {
+	if n < 0 {
+		return fmt.Errorf("n must be >= 0, got %d", n)
+	}
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cr.ReuseRecord = true
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	header = append([]string(nil), header...)
+	ring := make([][]string, n)
+	total := 0
+	for {
+		rec, err := cr.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return err
+		}
+		if n > 0 {
+			i := total % n
+			ring[i] = append(ring[i][:0], rec...)
+		}
+		total++
+	}
+	cw := csv.NewWriter(w)
+	cw.Comma = delim
+	if err := cw.Write(header); err != nil {
+		return err
+	}
+	first := max(total-n, 0)
+	for i := first; i < total; i++ {
+		if err := cw.Write(ring[i%n]); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
