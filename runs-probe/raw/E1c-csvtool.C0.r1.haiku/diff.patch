index 0000000..c57606e
--- /dev/null
+++ b/tail_test.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func tailOf(in string, n int, delim rune, lazy bool) (string, error) {
+	var sb strings.Builder
+	err := Tail(strings.NewReader(in), &sb, n, delim, lazy)
+	return sb.String(), err
+}
+
+func TestTail(t *testing.T) {
+	in := "a,b\n1,x\n2,y\n3,z\n4,w\n5,v\n"
+	cases := []struct {
+		n    int
+		want string
+	}{
+		{0, "a,b\n"},
+		{2, "a,b\n4,w\n5,v\n"},
+		{5, "a,b\n1,x\n2,y\n3,z\n4,w\n5,v\n"},
+		{9, "a,b\n1,x\n2,y\n3,z\n4,w\n5,v\n"},
+	}
+	for _, tc := range cases {
+		got, err := tailOf(in, tc.n, ',', false)
+		if err != nil {
+			t.Fatalf("n=%d: %v", tc.n, err)
+		}
+		if got != tc.want {
+			t.Errorf("n=%d: got %q, want %q", tc.n, got, tc.want)
+		}
+	}
+}
+
+func TestTailQuotedFieldsAndDelim(t *testing.T) {
+	got, err := tailOf("a;b\n\"x;y\";1\n\"multi\nline\";2\n", 1, ';', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a;b\n\"multi\nline\";2\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestTailEmptyAndHeaderOnly(t *testing.T) {
+	if got, err := tailOf("", 3, ',', false); err != nil || got != "" {
+		t.Errorf("empty input: got %q, %v", got, err)
+	}
+	if got, err := tailOf("a,b\n", 3, ',', false); err != nil || got != "a,b\n" {
+		t.Errorf("header only: got %q, %v", got, err)
+	}
+}
+
+func TestTailRejectsNegativeN(t *testing.T) {
+	if _, err := tailOf("a\n1\n", -1, ',', false); err == nil {
+		t.Error("want error for n < 0")
+	}
+}
+
+func TestTailReadErrorPrintsNothing(t *testing.T) {
+	got, err := tailOf("a,b\n1,2\n\"3,4\n", 5, ',', false)
+	if err == nil {
+		t.Fatal("want error for unterminated quote")
+	}
+	if got != "" {
+		t.Errorf("got %q, want no output on error", got)
+	}
+}
