+    def requeue(self, task_id):
+        """Put a dead task back in the queue with a fresh attempt budget.
+
+        Return True if requeued, False if the task exists but is not dead, and
+        None if no such task exists.
+        """
+        conn = self._connect()
+        try:
+            with conn:
+                conn.execute("BEGIN IMMEDIATE")
+                row = conn.execute(
+                    "SELECT status FROM tasks WHERE id = ?", (task_id,)
+                ).fetchone()
+                if row is None:
+                    return None
+                if row[0] != "dead":
+                    return False
+                conn.execute(
+                    "UPDATE tasks SET status = 'pending', attempts = 0, not_before = NULL "
+                    "WHERE id = ?",
+                    (task_id,),
+                )
+                return True
+        finally:
+            conn.close()
+
+
