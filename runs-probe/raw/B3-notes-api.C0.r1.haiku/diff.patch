+// A crash between writeFileSync and renameSync leaves `<file>.<pid>.tmp` behind. Remove those at startup.
+// Only names of the form `<file>.<something>.tmp` match, so the data file itself is never touched.
+function removeStaleTempFiles(file: string): void {
+  const prefix = `${basename(file)}.`;
+  for (const name of readdirSync(dirname(file))) {
+    if (name.startsWith(prefix) && name.endsWith('.tmp') && name.length > prefix.length + '.tmp'.length) {
+      rmSync(join(dirname(file), name), { force: true });
+    }
+  }
+}
