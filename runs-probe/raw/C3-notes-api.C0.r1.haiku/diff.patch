diff --git a/src/validation.ts b/src/validation.ts
index b622ad8..3917f1d 100644
--- a/src/validation.ts
+++ b/src/validation.ts
@@ -25,6 +25,23 @@ export function validateNoteInput(input: unknown): ValidationResult {
   return { ok: true, value: { title, body } };
 }
 
+export const MIN_LIMIT = 1;
+export const MAX_LIMIT = 100;
+
+export type LimitValidationResult = { ok: true; value: number } | { ok: false; message: string };
+
+// Digits only: rejects '', '1.5', '1e2', '+5' and ' 5', which Number() would otherwise accept.
+export function validateLimit(raw: string): LimitValidationResult {
+  if (!/^\d+$/.test(raw)) {
+    return { ok: false, message: `limit must be an integer from ${MIN_LIMIT} to ${MAX_LIMIT}` };
+  }
+  const value = Number(raw);
+  if (value < MIN_LIMIT || value > MAX_LIMIT) {
+    return { ok: false, message: `limit must be an integer from ${MIN_LIMIT} to ${MAX_LIMIT}` };
+  }
+  return { ok: true, value };
+}
+
 export type PatchValidationResult =
   | { ok: true; value: Partial<NoteInput> }
   | { ok: false; message: string };
