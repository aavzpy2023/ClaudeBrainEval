+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Distinct streams the CSV in r and writes each distinct value of column col to
+// w, one per line, in order of first appearance. An empty cell is a value like
+// any other. A missing column is reported before anything is written.
+func Distinct(r io.Reader, w io.Writer, col string, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cr.ReuseRecord = true
+	header, err := cr.Read()
+	if err == io.EOF {
+		return fmt.Errorf("%w: %q (empty input)", ErrMissingColumn, col)
+	}
+	if err != nil {
+		return err
+	}
+	idx := -1
+	for j, h := range header {
+		if h == col {
+			idx = j
+			break
+		}
+	}
+	if idx < 0 {
+		return fmt.Errorf("%w: %q", ErrMissingColumn, col)
+	}
+	cw := csv.NewWriter(w)
+	cw.Comma = delim
+	seen := make(map[string]bool)
+	for {
+		rec, err := cr.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			cw.Flush()
+			return err
+		}
+		v := ""
+		if idx < len(rec) {
+			v = rec[idx]
+		}
+		if seen[v] {
+			continue
+		}
+		seen[v] = true
+		if err := cw.Write([]string{v}); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
diff --git a/distinct_test.go b/distinct_test.go
new file mode 100644
index 0000000..10d4df7
--- /dev/null
+++ b/distinct_test.go
@@ -0,0 +1,50 @@
+package main
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func distinctOf(in, col string) (string, error) {
+	var sb strings.Builder
+	err := Distinct(strings.NewReader(in), &sb, col, ',', false)
+	return sb.String(), err
+}
+
+func TestDistinctFirstAppearanceOrder(t *testing.T) {
+	got, err := distinctOf("a,b\n1,x\n2,y\n3,x\n4,z\n5,y\n", "b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "x\ny\nz\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDistinctEmptyCellIsAValue(t *testing.T) {
+	got, err := distinctOf("a,b\n1,\n2,x\n3,\n", "b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "\nx\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDistinctShortRowIsEmpty(t *testing.T) {
+	got, err := distinctOf("a,b\n1\n2,x\n", "b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "\nx\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestDistinctMissingColumn(t *testing.T) {
+	_, err := distinctOf("a,b\n1,2\n", "c")
+	if !errors.Is(err, ErrMissingColumn) {
+		t.Fatalf("got %v, want ErrMissingColumn", err)
+	}
+}
