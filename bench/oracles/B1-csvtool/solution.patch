-	var count int
+	var count, numeric int
 	var sum float64
 	for row := 2; ; row++ {
 		rec, err := cr.Read()
@@ -59,7 +57,12 @@ func Stats(r io.Reader, w io.Writer, col string, delim rune, lazy bool) error {
 			return fmt.Errorf("row %d: column %q: %q is not a number", row, col, rec[idx])
