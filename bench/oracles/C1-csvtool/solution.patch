+// Count writes the number of data rows (everything after the header) to w.
+func Count(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cr.ReuseRecord = true
+	n := 0
+	for first := true; ; first = false {
+		_, err := cr.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return err
+		}
+		if !first {
+			n++
+		}
+	}
+	_, err := fmt.Fprintln(w, n)
+	return err
+}
