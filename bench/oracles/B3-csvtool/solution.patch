+// resolveDelim turns the "auto" sentinel (0) into a real delimiter by peeking at the first line
+// of r: the most frequent of , ; tab | outside quotes, comma when none appears. Any other d is
+// returned unchanged. The returned reader still yields every byte of r.
+func resolveDelim(r io.Reader, d rune) (io.Reader, rune) {
+	if d != 0 {
+		return r, d
+	}
+	br := bufio.NewReader(r)
+	head, _ := br.Peek(4096)
+	if i := bytes.IndexByte(head, '\n'); i >= 0 {
+		head = head[:i]
+	}
+	counts := map[rune]int{}
+	inQuotes := false
+	for _, c := range string(head) {
+		switch {
+		case c == '"':
+			inQuotes = !inQuotes
+		case !inQuotes:
+			counts[c]++
+		}
+	}
+	best, most := ',', 0
+	for _, c := range []rune{',', ';', '\t', '|'} {
+		if counts[c] > most {
+			best, most = c, counts[c]
+		}
+	}
+	return br, best
+}
