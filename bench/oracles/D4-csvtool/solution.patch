 	cw.Flush()
 	return cw.Error()
 }
+
+// Distinct writes the distinct values of column col, in order of first appearance, one per line.
+// A missing column is reported as ErrMissingColumn before anything is written.
+func Distinct(r io.Reader, w io.Writer, col string, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cr.ReuseRecord = true
+	header, err := cr.Read()
+	if err == io.EOF {
+		return fmt.Errorf("%w: %q (empty input)", ErrMissingColumn, col)
+	}
+	if err != nil {
+		return err
+	}
+	idx := -1
+	for j, h := range header {
+		if h == col {
+			idx = j
+			break
+		}
+	}
+	if idx < 0 {
+		return fmt.Errorf("%w: %q", ErrMissingColumn, col)
+	}
+	seen := map[string]bool{}
+	for {
+		rec, err := cr.Read()
+		if err == io.EOF {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		v := ""
+		if idx < len(rec) {
+			v = rec[idx]
+		}
+		if !seen[v] {
+			seen[v] = true
+			if _, err := fmt.Fprintln(w, v); err != nil {
+				return err
+			}
+		}
+	}
+}
