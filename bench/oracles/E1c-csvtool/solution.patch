diff --git a/csvtool.go b/csvtool.go
index d74c10b..b23a8f5 100644
--- a/csvtool.go
+++ b/csvtool.go
@@ -275,3 +275,53 @@ func Select(r io.Reader, w io.Writer, cols []string, delim rune, lazy bool) erro
 	cw.Flush()
 	return cw.Error()
 }
+
+// Tail writes the header and the last n data rows of r to w. It keeps at most n rows in memory.
+func Tail(r io.Reader, w io.Writer, n int, delim rune, lazy bool) error {
+	if n < 0 {
+		return fmt.Errorf("n must be >= 0, got %d", n)
+	}
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	cw := csv.NewWriter(w)
+	cw.Comma = delim
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if err := cw.Write(header); err != nil {
+		return err
+	}
+	ring := make([][]string, n)
+	count := 0
+	for {
+		rec, err := cr.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			cw.Flush()
+			return err
+		}
+		if n > 0 {
+			ring[count%n] = append([]string(nil), rec...)
+		}
+		count++
+	}
+	kept := count
+	if kept > n {
+		kept = n
+	}
+	for i := count - kept; i < count; i++ {
+		if err := cw.Write(ring[i%n]); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
