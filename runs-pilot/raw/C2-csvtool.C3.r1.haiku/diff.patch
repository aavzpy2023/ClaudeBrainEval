new file mode 100644
index 0000000..1683eea
--- /dev/null
+++ b/columns_test.go
@@ -0,0 +1,66 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func columnsOf(in string, delim rune, lazy bool) (string, error) {
+	var sb strings.Builder
+	err := Columns(strings.NewReader(in), &sb, delim, lazy)
+	return sb.String(), err
+}
+
+func TestColumnsHeaderOnePerLine(t *testing.T) {
+	got, err := columnsOf("name,age,city\nann,30,oslo\n", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "name\nage\ncity\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsEmptyInputPrintsNothing(t *testing.T) {
+	got, err := columnsOf("", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "" {
+		t.Fatalf("got %q, want empty output", got)
+	}
+}
+
+func TestColumnsQuotedName(t *testing.T) {
+	got, err := columnsOf("\"last, first\",age\n", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "last, first\nage\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsDelim(t *testing.T) {
+	got, err := columnsOf("a;b\n1;2\n", ';', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsLazyQuotes(t *testing.T) {
+	in := "a,b\"c\n1,2\n"
+	if _, err := columnsOf(in, ',', false); err == nil {
+		t.Fatal("strict parsing: want error for stray quote in header")
+	}
+	got, err := columnsOf(in, ',', true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\"c\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
