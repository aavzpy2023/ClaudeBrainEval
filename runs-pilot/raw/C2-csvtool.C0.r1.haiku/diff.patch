+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Columns writes the column names in the header of the CSV in r to w, one per
+// line. Empty input prints nothing and is not an error.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, h := range header {
+		if _, err := fmt.Fprintln(w, h); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/columns_test.go b/columns_test.go
new file mode 100644
index 0000000..c9dd0b0
--- /dev/null
+++ b/columns_test.go
@@ -0,0 +1,45 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func columnsOf(in string, delim rune, lazy bool) (string, error) {
+	var sb strings.Builder
+	err := Columns(strings.NewReader(in), &sb, delim, lazy)
+	return sb.String(), err
+}
+
+func TestColumns(t *testing.T) {
+	got, err := columnsOf("name,age,city\nann,3,x\n", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "name\nage\ncity\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsEmptyInput(t *testing.T) {
+	got, err := columnsOf("", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "" {
+		t.Fatalf("got %q, want no output", got)
+	}
+}
+
+func TestColumnsDelimAndLazy(t *testing.T) {
+	got, err := columnsOf("a\tb \"c\tx\n", '\t', true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb \"c\nx\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+	if _, err := columnsOf("a,b\"c\n", ',', false); err == nil {
+		t.Fatal("want error for bare quote without --lazy-quotes")
+	}
+}
