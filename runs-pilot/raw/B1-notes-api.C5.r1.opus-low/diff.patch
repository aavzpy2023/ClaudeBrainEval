diff --git a/src/store.ts b/src/store.ts
index a5dfbe6..eaaecea 100644
--- a/src/store.ts
+++ b/src/store.ts
@@ -26,7 +26,16 @@ export type NoteStore = {
 // Options: a file lock, or moving to SQLite. Not decided; do not assume either.
 function load(file: string): StoredNote[] {
   if (!existsSync(file)) return [];
-  return JSON.parse(readFileSync(file, 'utf8')) as StoredNote[];
+  const text = readFileSync(file, 'utf8');
+  try {
+    const parsed: unknown = JSON.parse(text);
+    if (Array.isArray(parsed)) return parsed as StoredNote[];
+  } catch (err) {
+    if (!(err instanceof SyntaxError)) throw err;
+  }
+  // Unparseable (or not an array): keep it for inspection and start empty rather than failing startup.
+  renameSync(file, `${file}.corrupt`);
+  return [];
 }
 
 // Write a temp file next to the target, then rename over it, so a crash never leaves a half-written file.
