@@ -15,6 +15,19 @@ def _print_json(doc):
     print(json.dumps({"v": SCHEMA_VERSION, **doc}))
 
 
+def _positive_int(value):
+    number = int(value)
+    if number < 1:
+        raise argparse.ArgumentTypeError(f"must be at least 1: {value}")
+    return number
+
+
+def _listed(repo, limit):
+    """Return the tasks `list` shows: all of them, or the first `limit` in insertion order."""
+    tasks = repo.list_tasks()
+    return tasks if limit is None else tasks[:limit]
+
+
 def main(argv=None):
     parser = argparse.ArgumentParser(prog="taskq")
     sub = parser.add_subparsers(dest="command", required=True)
