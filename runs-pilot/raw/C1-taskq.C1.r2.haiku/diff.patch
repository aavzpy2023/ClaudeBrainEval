     ls.add_argument("--json", action="store_true", help="print JSON")
+    ls.add_argument("--limit", type=_positive_int, metavar="N", help="show at most N tasks")
     claim = sub.add_parser("claim", help="claim the next pending task")
     claim.add_argument("--json", action="store_true", help="print JSON")
     done = sub.add_parser("done", help="mark a task done")
@@ -70,11 +84,11 @@ def main(argv=None):
