diff --git a/columns_test.go b/columns_test.go
new file mode 100644
index 0000000..d40a343
--- /dev/null
+++ b/columns_test.go
@@ -0,0 +1,50 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	var out strings.Builder
+	if err := Columns(strings.NewReader("name,age\nbob,3\n"), &out, ',', false); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := out.String(), "name\nage\n"; got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsEmptyInput(t *testing.T) {
+	var out strings.Builder
+	if err := Columns(strings.NewReader(""), &out, ',', false); err != nil {
+		t.Fatal(err)
+	}
+	if out.Len() != 0 {
+		t.Errorf("got %q, want no output", out.String())
+	}
+}
+
+func TestColumnsDelimAndQuotes(t *testing.T) {
+	var out strings.Builder
+	if err := Columns(strings.NewReader("\"a;b\";c\n1;2\n"), &out, ';', false); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := out.String(), "a;b\nc\n"; got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsLazyQuotes(t *testing.T) {
+	in := "na\"me,age\n"
+	if err := Columns(strings.NewReader(in), &strings.Builder{}, ',', false); err == nil {
+		t.Error("strict: want error for stray quote")
+	}
+	var out strings.Builder
+	if err := Columns(strings.NewReader(in), &out, ',', true); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := out.String(), "na\"me\nage\n"; got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
