diff --git a/taskq/repository.py b/taskq/repository.py
index 8247752..47313d1 100644
--- a/taskq/repository.py
+++ b/taskq/repository.py
@@ -93,11 +93,15 @@ class Repository:
             conn.close()
 
 
-    def list_tasks(self):
-        """Return all tasks as (id, priority, payload) tuples in insertion order."""
+    def list_tasks(self, limit=None):
+        """Return up to limit tasks (all if None) as (id, priority, payload) tuples in insertion order."""
         conn = self._connect()
         try:
-            return conn.execute("SELECT id, priority, payload FROM tasks ORDER BY id"
+            if limit is None:
+                return conn.execute("SELECT id, priority, payload FROM tasks ORDER BY id"
+                ).fetchall()
+            return conn.execute(
+                "SELECT id, priority, payload FROM tasks ORDER BY id LIMIT ?", (limit,)
             ).fetchall()
         finally:
             conn.close()
diff --git a/tests/test_cli.py b/tests/test_cli.py
