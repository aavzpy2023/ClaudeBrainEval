@@ -105,3 +105,28 @@ class CliTest(unittest.TestCase):
         first, second = map(json.loads, out.getvalue().splitlines())
         self.assertEqual(first, {"v": 1, "task": {"id": 1, "text": "hello"}})
         self.assertEqual(second, {"v": 1, "task": None})
+
+    def test_list_limit(self):
+        with tempfile.TemporaryDirectory() as d:
+            with mock.patch.dict(os.environ, {"TASKQ_DB": os.path.join(d, "t.db")}):
+                with contextlib.redirect_stdout(io.StringIO()):
+                    for text in ["a", "b", "c"]:
+                        cli.main(["add", text])
+                out = io.StringIO()
+                with contextlib.redirect_stdout(out):
+                    cli.main(["list", "--limit", "2"])
+                    cli.main(["list", "--json", "--limit", "2"])
+        lines = out.getvalue().splitlines()
+        self.assertEqual(lines[:2], ["1\t5\ta", "2\t5\tb"])
+        self.assertEqual(
+            json.loads(lines[2]),
+            {"v": 1, "tasks": [{"id": 1, "priority": 5, "text": "a"}, {"id": 2, "priority": 5, "text": "b"}]},
+        )
+
+    def test_list_limit_rejects_below_one(self):
+        for value in ["0", "-3"]:
+            with self.subTest(value=value):
+                with contextlib.redirect_stderr(io.StringIO()):
+                    with self.assertRaises(SystemExit) as cm:
+                        cli.main(["list", "--limit", value])
+                self.assertEqual(cm.exception.code, 2)
