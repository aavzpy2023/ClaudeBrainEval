+    def test_list_limit(self):
+        with tempfile.TemporaryDirectory() as d:
+            with mock.patch.dict(os.environ, {"TASKQ_DB": os.path.join(d, "t.db")}):
+                with contextlib.redirect_stdout(io.StringIO()):
+                    for text in ("a", "b", "c"):
+                        cli.main(["add", text])
+                out = io.StringIO()
+                with contextlib.redirect_stdout(out):
+                    cli.main(["list", "--limit", "2"])
+                    cli.main(["list", "--json", "--limit", "1"])
+        plain, js = out.getvalue().split("\n", 2)[:2], out.getvalue().splitlines()[2]
