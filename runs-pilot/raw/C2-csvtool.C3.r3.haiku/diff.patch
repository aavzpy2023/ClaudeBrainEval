+++ b/columns_test.go
@@ -0,0 +1,56 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func columnsOf(in string, delim rune, lazy bool) (string, error) {
+	var sb strings.Builder
+	err := Columns(strings.NewReader(in), &sb, delim, lazy)
+	return sb.String(), err
+}
+
+func TestColumnsPrintsHeaderOnePerLine(t *testing.T) {
+	got, err := columnsOf("name,age,city\nann,30,oslo\n", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "name\nage\ncity\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsEmptyInputPrintsNothing(t *testing.T) {
+	got, err := columnsOf("", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "" {
+		t.Fatalf("got %q, want empty", got)
+	}
+}
+
+func TestColumnsCustomDelimiter(t *testing.T) {
+	got, err := columnsOf("a\tb c\t d\n1\t2\t3\n", '\t', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb c\n d\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsLazyQuotes(t *testing.T) {
+	in := "a,b\"c,d\n1,2,3\n"
+	if _, err := columnsOf(in, ',', false); err == nil {
+		t.Fatal("strict parsing accepted a stray quote")
+	}
+	got, err := columnsOf(in, ',', true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\"c\nd\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
