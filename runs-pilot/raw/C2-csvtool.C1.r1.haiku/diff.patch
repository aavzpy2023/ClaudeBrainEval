+// Columns writes the header's column names to w, one per line. Only the header
+// is read. Empty input produces no output and no error.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	bw := bufio.NewWriter(w)
+	for _, h := range header {
+		bw.WriteString(h)
+		bw.WriteByte('\n')
+	}
+	return bw.Flush()
+}
+
 // ErrMissingColumn is returned by Select when a requested column is not in the header.
 var ErrMissingColumn = errors.New("missing column")
 
