@@ -0,0 +1,50 @@
+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	tests := []struct {
+		name, in, want string
+	}{
+		{"header only", "a,b,c\n1,2,3\n", "a\nb\nc\n"},
+		{"header with no rows", "name,age\n", "name\nage\n"},
+		{"quoted name with comma", "\"x,y\",z\n", "x,y\nz\n"},
+		{"empty input", "", ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := Columns(strings.NewReader(tc.in), &buf, ',', false); err != nil {
+				t.Fatal(err)
+			}
+			if got := buf.String(); got != tc.want {
+				t.Errorf("got %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestColumnsDelimAndLazy(t *testing.T) {
+	var buf bytes.Buffer
+	if err := Columns(strings.NewReader("a\tb\n1\t2\n"), &buf, '\t', false); err != nil {
+		t.Fatal(err)
+	}
+	if got := buf.String(); got != "a\nb\n" {
+		t.Errorf("tab-delimited: got %q", got)
+	}
+	buf.Reset()
+	if err := Columns(strings.NewReader("a \"q\",b\n"), &buf, ',', true); err != nil {
+		t.Fatalf("lazy quotes: %v", err)
+	}
+	if got := buf.String(); got != "a \"q\"\nb\n" {
+		t.Errorf("lazy: got %q", got)
+	}
+	buf.Reset()
+	if err := Columns(strings.NewReader("a \"q\",b\n"), &buf, ',', false); err == nil {
+		t.Error("strict quotes: expected error for bare quote")
+	}
+}
