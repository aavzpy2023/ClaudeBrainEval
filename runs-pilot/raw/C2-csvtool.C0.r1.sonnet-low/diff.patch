+func TestColumns(t *testing.T) {
+	var sb strings.Builder
+	if err := Columns(strings.NewReader("a;b\"x;c\n1;2;3\n"), &sb, ';', true); err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\"x\nc\n"; sb.String() != want {
+		t.Errorf("got %q, want %q", sb.String(), want)
+	}
+	sb.Reset()
+	if err := Columns(strings.NewReader(""), &sb, ',', false); err != nil || sb.Len() != 0 {
+		t.Errorf("empty input: got %q, err %v", sb.String(), err)
+	}
+}
