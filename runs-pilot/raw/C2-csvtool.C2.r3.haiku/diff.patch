@@ -0,0 +1,29 @@
+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Columns writes the header names of the CSV in r to w, one per line. Only the
+// header row is read. Empty input writes nothing and is not an error.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, h := range header {
+		if _, err := fmt.Fprintln(w, h); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/columns_test.go b/columns_test.go
new file mode 100644
index 0000000..15b647b
--- /dev/null
+++ b/columns_test.go
@@ -0,0 +1,32 @@
+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	tests := []struct {
+		name, in, want string
+		delim          rune
+		lazy           bool
+	}{
+		{"header only", "a,b,c\n1,2,3\n", "a\nb\nc\n", ',', false},
+		{"empty input", "", "", ',', false},
+		{"tab delimiter", "a\tb\n1\t2\n", "a\nb\n", '\t', false},
+		{"quoted name with comma", "\"x,y\",z\n", "x,y\nz\n", ',', false},
+		{"lazy quotes", "a\"b,c\n", "a\"b\nc\n", ',', true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := Columns(strings.NewReader(tt.in), &buf, tt.delim, tt.lazy); err != nil {
+				t.Fatal(err)
+			}
+			if got := buf.String(); got != tt.want {
+				t.Errorf("got %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
