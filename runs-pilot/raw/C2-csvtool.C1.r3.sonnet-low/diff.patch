+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	tests := []struct {
+		name, in, want string
+		delim          rune
+		lazy           bool
+	}{
+		{"basic", "name,age\nann,3\n", "name\nage\n", ',', false},
+		{"empty", "", "", ',', false},
+		{"delim", "a;b\n1;2\n", "a\nb\n", ';', false},
+		{"lazy", "a,b\"c\n1,2\n", "a\nb\"c\n", ',', true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var sb strings.Builder
+			if err := Columns(strings.NewReader(tt.in), &sb, tt.delim, tt.lazy); err != nil {
+				t.Fatal(err)
+			}
+			if sb.String() != tt.want {
+				t.Errorf("got %q, want %q", sb.String(), tt.want)
+			}
+		})
+	}
+}
+
+func TestColumnsStrictBareQuote(t *testing.T) {
+	var sb strings.Builder
+	if err := Columns(strings.NewReader("a,b\"c\n"), &sb, ',', false); err == nil {
+		t.Error("want error for bare quote without lazy quotes")
+	}
+}
