+func TestColumns(t *testing.T) {
+	tests := []struct {
+		name, in string
+		delim    rune
+		want     string
+	}{
+		{"basic", "a,b,c\n1,2,3\n", ',', "a\nb\nc\n"},
+		{"header only", "a,b\n", ',', "a\nb\n"},
+		{"empty input", "", ',', ""},
+		{"tab delim", "a\tb\n1\t2\n", '\t', "a\nb\n"},
+		{"quoted name", "\"x,y\",z\n", ',', "x,y\nz\n"},
+		{"ragged data row", "a,b\n1,2,3\n", ',', "a\nb\n"},
+	}
+	for _, tc := range tests {
+		var buf bytes.Buffer
+		if err := Columns(strings.NewReader(tc.in), &buf, tc.delim, false); err != nil {
+			t.Fatalf("%s: %v", tc.name, err)
+		}
+		if buf.String() != tc.want {
+			t.Errorf("%s: got %q, want %q", tc.name, buf.String(), tc.want)
+		}
+	}
+}
+
+func TestColumnsLazyQuotes(t *testing.T) {
+	var buf bytes.Buffer
+	if err := Columns(strings.NewReader("a\"b,c\n"), &buf, ',', true); err != nil {
+		t.Fatal(err)
+	}
+	if buf.String() != "a\"b\nc\n" {
+		t.Errorf("got %q", buf.String())
+	}
+	if err := Columns(strings.NewReader("a\"b,c\n"), &bytes.Buffer{}, ',', false); err == nil {
+		t.Error("strict parsing accepted a bare quote")
+	}
+}
