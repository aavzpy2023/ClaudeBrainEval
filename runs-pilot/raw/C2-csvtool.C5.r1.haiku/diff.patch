+// Columns writes each column name in the header of the CSV in r to w, one per
+// line. Empty input prints nothing.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	bw := bufio.NewWriter(w)
+	for _, h := range header {
+		bw.WriteString(h)
+		bw.WriteByte('\n')
+	}
+	return bw.Flush()
+}
