+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	tests := []struct {
+		name, in string
+		delim    rune
+		lazy     bool
+		want     string
+	}{
+		{"basic", "a,b,c\n1,2,3\n", ',', false, "a\nb\nc\n"},
+		{"empty input", "", ',', false, ""},
+		{"header only", "x,y\n", ',', false, "x\ny\n"},
+		{"quoted", "\"a,b\",c\n1,2\n", ',', false, "a,b\nc\n"},
+		{"tab delim", "a\tb\n1\t2\n", '\t', false, "a\nb\n"},
+		{"lazy quotes", "a\"b,c\n1,2\n", ',', true, "a\"b\nc\n"},
+	}
+	for _, tt := range tests {
+		var sb strings.Builder
+		if err := Columns(strings.NewReader(tt.in), &sb, tt.delim, tt.lazy); err != nil {
+			t.Errorf("%s: %v", tt.name, err)
+			continue
+		}
+		if sb.String() != tt.want {
+			t.Errorf("%s: got %q, want %q", tt.name, sb.String(), tt.want)
+		}
+	}
+}
+
+func TestColumnsStrictQuoteError(t *testing.T) {
+	var sb strings.Builder
+	if err := Columns(strings.NewReader("a\"b,c\n"), &sb, ',', false); err == nil {
+		t.Error("want error for stray quote without lazy quotes")
+	}
+}
