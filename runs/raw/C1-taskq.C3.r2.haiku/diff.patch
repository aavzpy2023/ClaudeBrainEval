+def _positive_int(text):
+    # argparse turns ArgumentTypeError into a usage error, exit status 2.
+    value = int(text)
+    if value < 1:
+        raise argparse.ArgumentTypeError(f"must be at least 1, got {value}")
+    return value
+
+
 def main(argv=None):
