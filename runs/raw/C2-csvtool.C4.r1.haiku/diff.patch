+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Columns writes the header names of the CSV in r to w, one per line. Empty
+// input produces no output and no error.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, h := range header {
+		if _, err := fmt.Fprintln(w, h); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/columns_test.go b/columns_test.go
new file mode 100644
index 0000000..15e4aa9
--- /dev/null
+++ b/columns_test.go
@@ -0,0 +1,42 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func columnsOf(in string, delim rune) (string, error) {
+	var sb strings.Builder
+	err := Columns(strings.NewReader(in), &sb, delim, false)
+	return sb.String(), err
+}
+
+func TestColumnsPrintsHeader(t *testing.T) {
+	got, err := columnsOf("name,age,city\n a,1,x\n", ',')
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "name\nage\ncity\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsEmptyInput(t *testing.T) {
+	got, err := columnsOf("", ',')
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "" {
+		t.Fatalf("want no output, got %q", got)
+	}
+}
+
+func TestColumnsDelim(t *testing.T) {
+	got, err := columnsOf("a\tb\n1\t2\n", '\t')
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
