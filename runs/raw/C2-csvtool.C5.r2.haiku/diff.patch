+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// Columns writes the names in the header row of the CSV in r to w, one per
+// line, in column order. Only the header is read. Empty input writes nothing.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, h := range header {
+		if _, err := fmt.Fprintln(w, h); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/columns_test.go b/columns_test.go
new file mode 100644
index 0000000..eb82a0e
--- /dev/null
+++ b/columns_test.go
@@ -0,0 +1,30 @@
+package main
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	cases := []struct {
+		name, in, want string
+		delim          rune
+	}{
+		{"basic", "a,b,c\n1,2,3\n", "a\nb\nc\n", ','},
+		{"header only", "name,age\n", "name\nage\n", ','},
+		{"empty input", "", "", ','},
+		{"tab delimiter", "a\tb\n1\t2\n", "a\nb\n", '\t'},
+		{"quoted name", "\"x,y\",z\n", "x,y\nz\n", ','},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := Columns(bytes.NewBufferString(tc.in), &buf, tc.delim, false); err != nil {
+				t.Fatal(err)
+			}
+			if got := buf.String(); got != tc.want {
+				t.Errorf("got %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
