diff --git a/src/store.ts b/src/store.ts
index a5dfbe6..0780e30 100644
--- a/src/store.ts
+++ b/src/store.ts
@@ -26,7 +26,15 @@ export type NoteStore = {
 // Options: a file lock, or moving to SQLite. Not decided; do not assume either.
 function load(file: string): StoredNote[] {
   if (!existsSync(file)) return [];
-  return JSON.parse(readFileSync(file, 'utf8')) as StoredNote[];
+  try {
+    const parsed = JSON.parse(readFileSync(file, 'utf8'));
+    if (!Array.isArray(parsed)) throw new Error('not an array');
+    return parsed as StoredNote[];
+  } catch {
+    // Unreadable file: keep it for inspection and start empty rather than failing startup.
+    renameSync(file, `${file}.corrupt`);
+    return [];
+  }
 }
 
 // Write a temp file next to the target, then rename over it, so a crash never leaves a half-written file.
