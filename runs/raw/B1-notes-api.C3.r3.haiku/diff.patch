+describe('note store with a corrupt file', () => {
+  it('moves an unparseable file aside and starts empty', () => {
+    const file = fileIn('broken.json');
+    writeFileSync(file, 'not json');
+    assert.deepEqual(createStore(undefined, file).list(), []);
+    assert.equal(readFileSync(`${file}.corrupt`, 'utf8'), 'not json');
+    assert.equal(existsSync(file), false);
+  });
+
+  it('keeps working and persists over the recovered store', () => {
+    const file = fileIn('broken2.json');
+    writeFileSync(file, 'garbage');
+    const note = createStore(undefined, file).create({ title: 't', body: 'b' });
+    assert.equal(createStore(undefined, file).get(note.id)?.title, 't');
+  });
+});
