diff --git a/taskq/repository.py b/taskq/repository.py
index 8247752..f0127a8 100644
--- a/taskq/repository.py
+++ b/taskq/repository.py
@@ -93,11 +93,16 @@ class Repository:
             conn.close()
 
 
-    def list_tasks(self):
-        """Return all tasks as (id, priority, payload) tuples in insertion order."""
+    def list_tasks(self, limit=None):
+        """Return tasks as (id, priority, payload) tuples in insertion order.
+
+        At most `limit` tasks are returned when it is given.
+        """
         conn = self._connect()
         try:
-            return conn.execute("SELECT id, priority, payload FROM tasks ORDER BY id"
+            return conn.execute(
+                "SELECT id, priority, payload FROM tasks ORDER BY id LIMIT ?",
+                (-1 if limit is None else limit,),
             ).fetchall()
         finally:
             conn.close()
