+
+    def test_list_limit_shows_first_n_in_insertion_order(self):
+        with tempfile.TemporaryDirectory() as d:
+            with mock.patch.dict(os.environ, {"TASKQ_DB": os.path.join(d, "t.db")}):
+                with contextlib.redirect_stdout(io.StringIO()):
+                    for text in ("a", "b", "c"):
+                        cli.main(["add", text])
+                out = io.StringIO()
+                with contextlib.redirect_stdout(out):
+                    cli.main(["list", "--limit", "2"])
+        self.assertEqual(out.getvalue(), "1\t5\ta\n2\t5\tb\n")
+
+    def test_list_json_limit(self):
+        with tempfile.TemporaryDirectory() as d:
+            with mock.patch.dict(os.environ, {"TASKQ_DB": os.path.join(d, "t.db")}):
+                with contextlib.redirect_stdout(io.StringIO()):
+                    for text in ("a", "b", "c"):
+                        cli.main(["add", text])
+                out = io.StringIO()
+                with contextlib.redirect_stdout(out):
+                    cli.main(["list", "--json", "--limit", "1"])
+        self.assertEqual(
+            json.loads(out.getvalue()),
+            {"v": 1, "tasks": [{"id": 1, "priority": 5, "text": "a"}]},
+        )
+
+    def test_list_limit_below_one_is_usage_error(self):
+        for value in ("0", "-3"):
+            with self.subTest(value=value):
+                with contextlib.redirect_stderr(io.StringIO()):
+                    with self.assertRaises(SystemExit) as cm:
