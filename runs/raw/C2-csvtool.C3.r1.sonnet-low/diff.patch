+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func columnsOf(in string, delim rune, lazy bool) (string, error) {
+	var sb strings.Builder
+	err := Columns(strings.NewReader(in), &sb, delim, lazy)
+	return sb.String(), err
+}
+
+func TestColumns(t *testing.T) {
+	got, err := columnsOf("name,age\nann,3\n", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "name\nage\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsDelim(t *testing.T) {
+	got, err := columnsOf("a\tb\n1\t2\n", '\t', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsLazyQuotes(t *testing.T) {
+	in := "a,b\"c\n1,2\n"
+	if _, err := columnsOf(in, ',', false); err == nil {
+		t.Fatal("strict parse should fail on a stray quote")
+	}
+	got, err := columnsOf(in, ',', true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\"c\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsEmptyInput(t *testing.T) {
+	got, err := columnsOf("", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "" {
+		t.Fatalf("got %q, want no output", got)
+	}
+}
