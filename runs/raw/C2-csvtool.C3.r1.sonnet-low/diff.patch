 // Select streams only the named columns of the CSV in r to w, in the order
 // given, row by row. Names are matched case-sensitively against the header row.
 // A missing column is reported before anything is written.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	bw := bufio.NewWriter(w)
+	for _, name := range header {
+		fmt.Fprintln(bw, name)
+	}
+	return bw.Flush()
+}
