+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	var buf bytes.Buffer
+	in := "name;\"full age\";x\nann;3;4\n"
+	if err := Columns(strings.NewReader(in), &buf, ';', false); err != nil {
+		t.Fatal(err)
+	}
+	if want := "name\nfull age\nx\n"; buf.String() != want {
+		t.Errorf("got %q want %q", buf.String(), want)
+	}
+}
+
+func TestColumnsEmptyAndLazy(t *testing.T) {
+	var buf bytes.Buffer
+	if err := Columns(strings.NewReader(""), &buf, ',', false); err != nil || buf.Len() != 0 {
+		t.Errorf("empty: %q, %v", buf.String(), err)
+	}
+	in := "a,b\"c\n1,2\n"
+	if err := Columns(strings.NewReader(in), &buf, ',', false); err == nil {
+		t.Error("strict: want error for stray quote")
+	}
+	buf.Reset()
+	if err := Columns(strings.NewReader(in), &buf, ',', true); err != nil || buf.String() != "a\nb\"c\n" {
+		t.Errorf("lazy: %q, %v", buf.String(), err)
+	}
+}
