+package main
+
+import (
+	"encoding/csv"
+	"io"
+)
+
+// Columns streams the header of the CSV in r and writes each column name to w,
+// one per line. Empty input prints nothing.
+func Columns(r io.Reader, w io.Writer, delim rune, lazy bool) error {
+	cr := csv.NewReader(r)
+	cr.Comma = delim
+	cr.LazyQuotes = lazy
+	cr.FieldsPerRecord = -1
+	header, err := cr.Read()
+	if err == io.EOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, h := range header {
+		if _, err := io.WriteString(w, h+"\n"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
