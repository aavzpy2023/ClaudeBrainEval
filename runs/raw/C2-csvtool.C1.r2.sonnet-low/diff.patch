@@ -0,0 +1,31 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	tests := []struct {
+		name, in, want string
+		delim          rune
+		lazy           bool
+	}{
+		{"basic", "a,b,c\n1,2,3\n", "a\nb\nc\n", ',', false},
+		{"empty", "", "", ',', false},
+		{"delim", "a;b\n1;2\n", "a\nb\n", ';', false},
+		{"lazy", "a,b\"x,c\n", "a\nb\"x\nc\n", ',', true},
+	}
+	for _, tt := range tests {
+		var sb strings.Builder
+		if err := Columns(strings.NewReader(tt.in), &sb, tt.delim, tt.lazy); err != nil {
+			t.Fatalf("%s: %v", tt.name, err)
+		}
+		if sb.String() != tt.want {
+			t.Errorf("%s: got %q want %q", tt.name, sb.String(), tt.want)
+		}
+	}
+	if err := Columns(strings.NewReader("a,b\"x\n"), &strings.Builder{}, ',', false); err == nil {
+		t.Error("strict mode: want error for bare quote")
+	}
+}
