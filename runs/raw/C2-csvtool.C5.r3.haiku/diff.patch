new file mode 100644
index 0000000..99e4bdf
--- /dev/null
+++ b/columns_test.go
@@ -0,0 +1,55 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func columnsOf(in string, delim rune, lazy bool) (string, error) {
+	var sb strings.Builder
+	err := Columns(strings.NewReader(in), &sb, delim, lazy)
+	return sb.String(), err
+}
+
+func TestColumns(t *testing.T) {
+	got, err := columnsOf("name,age,city\nann,30,oslo\n", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "name\nage\ncity\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsEmptyInput(t *testing.T) {
+	got, err := columnsOf("", ',', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "" {
+		t.Fatalf("got %q, want no output", got)
+	}
+}
+
+func TestColumnsDelim(t *testing.T) {
+	got, err := columnsOf("a;b\n1;2\n", ';', false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestColumnsLazyQuotes(t *testing.T) {
+	if _, err := columnsOf("a,b\"c\n1,2\n", ',', false); err == nil {
+		t.Fatal("strict parsing: want error for bare quote")
+	}
+	got, err := columnsOf("a,b\"c\n1,2\n", ',', true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "a\nb\"c\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
