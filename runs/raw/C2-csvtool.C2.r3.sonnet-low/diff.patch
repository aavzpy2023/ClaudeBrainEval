+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestColumns(t *testing.T) {
+	tests := []struct {
+		name, in string
+		delim    rune
+		lazy     bool
+		want     string
+	}{
+		{"basic", "a,b,c\n1,2,3\n", ',', false, "a\nb\nc\n"},
+		{"empty", "", ',', false, ""},
+		{"delim", "a;b\n1;2\n", ';', false, "a\nb\n"},
+		{"quoted", "\"x,y\",z\n", ',', false, "x,y\nz\n"},
+		{"lazy", "a\"b,c\n", ',', true, "a\"b\nc\n"},
+	}
+	for _, tt := range tests {
+		var sb strings.Builder
+		if err := Columns(strings.NewReader(tt.in), &sb, tt.delim, tt.lazy); err != nil {
+			t.Fatalf("%s: %v", tt.name, err)
+		}
+		if sb.String() != tt.want {
+			t.Errorf("%s: got %q want %q", tt.name, sb.String(), tt.want)
+		}
+	}
+	if err := Columns(strings.NewReader("a\"b,c\n"), &strings.Builder{}, ',', false); err == nil {
+		t.Error("strict mode: expected error for bare quote")
+	}
+}
